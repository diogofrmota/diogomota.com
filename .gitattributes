# Every text file has LF line endings, in the repo and in every checkout, also on
# Windows with core.autocrlf=true (the Git for Windows default). Scripts and configs
# run on Linux (the VPS, containers), and the tooling writes LF, so a CRLF working
# copy only produces "LF will be replaced by CRLF" warnings.
* text=auto eol=lf

# Binary, never converted.
*.png   binary
*.ico   binary
*.woff  binary
*.woff2 binary
