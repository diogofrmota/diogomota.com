# Files that run on Linux (the VPS, containers) keep LF line endings, also in a
# Windows checkout with core.autocrlf, so they still work after being copied with scp.
*.sh           text eol=lf
*.conf         text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.sql          text eol=lf
.env*.example  text eol=lf
infra/crontab  text eol=lf
