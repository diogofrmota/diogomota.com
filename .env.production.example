# Production environment: copy to /opt/diogomota/.env on the VPS, chmod 600,
# fill in the values. Never commit the filled-in copy.
# docker compose reads it for the ${...} values in docker-compose.prod.yml, and the
# app container gets every variable in it (env_file).

# Lets plain `docker compose ...` in /opt/diogomota use the production file.
COMPOSE_FILE=docker-compose.prod.yml

# Image to run. Every deploy (infra/deploy.sh) sets it to the short commit SHA it
# deployed, so docker compose here keeps running that version, rollbacks included.
IMAGE_TAG=latest

# --- Database ---------------------------------------------------------------
# Creates the Postgres user and database on the first start of an empty volume.
POSTGRES_USER=diogomota
# Hex only (openssl rand -hex 32): it goes into DATABASE_URL without URL-encoding.
POSTGRES_PASSWORD=
POSTGRES_DB=diogomota
# DATABASE_URL is built from the three values above in docker-compose.prod.yml;
# don't set it here.

# --- Auth (Auth.js) ---------------------------------------------------------
# Signs session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://diogomota.com

# --- Email (Resend) ---------------------------------------------------------
# API key with sending access for the diogomota.com domain.
RESEND_API_KEY=
MAIL_FROM="diogomota.com <no-reply@diogomota.com>"

# --- TMDB -------------------------------------------------------------------
# v4 "API Read Access Token" (the long one).
TMDB_READ_TOKEN=
