# Copy to .env (read by docker compose) and to app/.env.local (read by Next.js
# and `npm run migrate`), then fill in the values. Never commit the copies.
# Production uses its own file on the VPS with freshly generated secrets.

# --- Database ---------------------------------------------------------------
# Used by docker compose to create the Postgres user and database on first start.
POSTGRES_USER=diogomota
POSTGRES_PASSWORD=change-me
POSTGRES_DB=diogomota

# Connection string for the app and the migration runner; must match the values above.
# Host is localhost in development and `postgres` (the compose service) in production.
# URL-encode special characters in the password (e.g. @ becomes %40).
DATABASE_URL=postgresql://diogomota:change-me@localhost:5432/diogomota

# --- Auth (Better Auth) -----------------------------------------------------
# Secret that signs session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public base URL of the site, used for auth callbacks and links in emails.
AUTH_URL=http://localhost:3000

# --- Email (Resend) ---------------------------------------------------------
# API key with sending access for the diogomota.com domain (password reset emails).
# In development, leave it empty to print emails to the console instead of sending them.
RESEND_API_KEY=
# Sender address for outgoing email.
MAIL_FROM="diogomota.com <no-reply@diogomota.com>"

# --- TMDB -------------------------------------------------------------------
# v4 "API Read Access Token" (the long one), sent as a Bearer token. Server-side only.
TMDB_READ_TOKEN=
